# Copy to .env and fill in values. Never commit the real .env file.

# --- Database ---
# Owner/write role: used by Alembic migrations and the ingestion CLI.
DATABASE_URL=postgresql+psycopg://rootlens_app:changeme_app@localhost:5432/rootlens
# Read-only role: used by every FastAPI query endpoint (dashboard, analytics tools).
DATABASE_URL_READONLY=postgresql+psycopg://rootlens_readonly:changeme_readonly@localhost:5432/rootlens
# Same database, separate name, used only by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://rootlens_app:changeme_app@localhost:5432/rootlens_test

# Postgres container init (used by docker-compose.yml / db/init scripts)
POSTGRES_DB=rootlens
POSTGRES_USER=rootlens_app
POSTGRES_PASSWORD=changeme_app
ROOTLENS_READONLY_PASSWORD=changeme_readonly

# --- Backend ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
